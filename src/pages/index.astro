---
import { url } from '../lib/url';
import '@fontsource-variable/manrope';
import '../styles/global.css';

const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const siteUrl = 'https://bess-consulting.de/';

const entity = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'BESS Consulting',
  url: siteUrl,
  logo: siteUrl + 'assets/bess-logo.webp',
  telephone: '+4917623724145',
  email: 'kontakt@bess-consulting.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Bruchsaler Str. 65',
    postalCode: '76646',
    addressLocality: 'Bruchsal',
    addressCountry: 'DE',
  },
  founder: { '@type': 'Person', name: 'Waldemar Brauer' },
  description: 'Energieaudit mit 36 Monaten Umsetzungsbegleitung für Handwerk und produzierende KMU.',
};

const results = [
  {
    num: '01 / Verstehen',
    title: 'Eine Übersicht Ihres Energieeinsatzes',
    copy: 'Verbräuche, Energieträger und wesentliche Anlagen im Zusammenhang betrachten. Damit sichtbar wird, wo eine vertiefte Analyse ansetzt.',
    icon: '<path d="M3 3v18h18"/><path d="m7 15 4-5 3 3 5-7"/>',
  },
  {
    num: '02 / Bewerten',
    title: 'Eine Bewertung möglicher Maßnahmen',
    copy: 'Effizienzmaßnahmen nach technischem Potenzial, Investitionsbedarf und erwartetem Nutzen einordnen. Mit offengelegten Annahmen.',
    icon: '<path d="M12 3v18"/><path d="M5 7h14"/><path d="m5 7-2 6a3.2 3.2 0 0 0 4 0Z"/><path d="m19 7 2 6a3.2 3.2 0 0 1-4 0Z"/>',
  },
  {
    num: '03 / Umsetzen',
    title: 'Jemanden, der dranbleibt',
    copy: 'Der Bericht ist der Anfang, nicht das Ende. Wir begleiten die Umsetzung, koordinieren Fördermittel und prüfen im Quartalsrhythmus, was tatsächlich ankommt.',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9 14h6"/><path d="M9 17h4"/>',
  },
];

const angebote = [
  {
    tag: 'Der schnelle Einstieg',
    name: 'Energie-Blitzaudit',
    price: 'ab 2.500 €',
    priceNote: 'Förderfähig, wir stellen den Antrag',
    lead: 'Sechzehn Stunden im Betrieb, zehn Seiten Aktionsplan, in drei Wochen bei Ihnen. Kein Bericht, den niemand liest.',
    points: [
      'Die drei Maßnahmen mit der kürzesten Amortisation',
      'Konkrete Euro-Beträge statt Prozentspannen',
      'Jederzeit auf das Vollaudit erweiterbar',
    ],
    cta: 'Blitzaudit besprechen',
    featured: false,
  },
  {
    tag: 'Das Kernprodukt',
    name: 'Audit + 36 Monate Begleitung',
    price: 'ca. 7.000 €',
    priceNote: 'Nach BAFA-Förderung ab ca. 1.400–3.500 € Eigenanteil',
    lead: 'Das vollständige Energieaudit — und danach drei Jahre an Ihrer Seite, bis die Maßnahmen laufen und die Einsparung messbar ist.',
    points: [
      'Quartalsberichte statt einmaliger Übergabe',
      'Fördermittel koordiniert, Anträge übernehmen wir',
      'Waldemar Brauer persönlich, kein wechselndes Personal',
    ],
    cta: 'Kernprodukt besprechen',
    featured: true,
  },
];

const branchen = [
  { name: 'Lackierereien', copy: 'Trockenkabinen, Abluft, Druckluft.' },
  { name: 'KFZ-Werkstätten', copy: 'Hebebühnen, Druckluft, Hallenwärme.' },
  { name: 'Metallbau & CNC', copy: 'Kühlwasser, Werkzeugmaschinen, Absaugung.' },
  { name: 'Lebensmittelverarbeitung', copy: 'Kälte, Hygienewärme, Betriebszeiten.' },
];

const fields = [
  { name: 'Produktion & Anlagen', copy: 'Betriebszeiten, Lastgänge und die Technik dahinter.' },
  { name: 'Wärme & Abwärme', copy: 'Erzeugung, Verteilung und ungenutzte Wärmeströme.' },
  { name: 'Druckluft & Kälte', copy: 'Erzeugung, Leckagen und Druckniveaus im Betrieb.' },
  { name: 'Antriebe & Beleuchtung', copy: 'Motoren, Regelung und Beleuchtung in den Hallen.' },
];

const steps = [
  {
    title: 'Den richtigen Rahmen setzen',
    copy: 'Wir besprechen Ihren Anlass, die relevanten Standorte und Ihre Datenlage. Daraus entsteht ein passender Leistungsumfang.',
  },
  {
    title: 'Daten mit der Praxis verbinden',
    copy: 'Verbrauchsübersichten und die Begehung vor Ort helfen, Anlagen und Abläufe im Zusammenhang zu verstehen.',
  },
  {
    title: 'Potenziale wirtschaftlich einordnen',
    copy: 'Wir analysieren mögliche Maßnahmen und betrachten Investition, Nutzen und zugrunde liegende Annahmen.',
  },
  {
    title: 'Dranbleiben, bis es wirkt',
    copy: 'Sie erhalten den Auditbericht, und danach beginnt die Begleitung: Umsetzung priorisieren, Förderanträge stellen, im Quartalsrhythmus nachhalten.',
  },
];

// Die ersten sechs stehen offen sichtbar, der Rest liegt hinter dem Umschalter.
const faqsPrimary = [
  {
    q: 'Was kostet ein Energieaudit?',
    a: 'Der Aufwand hängt unter anderem von Standorten, Anlagen, Datenlage und Leistungsumfang ab. Nach einer ersten Abstimmung lässt sich ein individuelles Angebot erstellen.',
  },
  {
    q: 'Sind wir zu einem Energieaudit verpflichtet?',
    a: `Das muss anhand Ihres Unternehmensstatus, Energieverbrauchs und vorhandener Managementsysteme geprüft werden. EDL-G und EnEfG haben unterschiedliche Anforderungen. <a href="${url('/blog/energieauditpflicht-enefg/')}">Zur Einordnung der Pflichten</a>.`,
  },
  {
    q: 'Wie viel Zeit müssen wir intern einplanen?',
    a: 'Ein Ansprechpartner im Unternehmen, verfügbare Verbrauchsdaten und Zugang zu den relevanten Anlagen erleichtern die Zusammenarbeit. Den konkreten Zeitbedarf stimmen wir anhand Ihres Betriebs und des vereinbarten Umfangs ab.',
  },
  {
    q: 'Welche Unterlagen werden benötigt?',
    a: 'Hilfreich sind Energieabrechnungen, Verbrauchsübersichten sowie Informationen zu Standorten und wesentlichen Anlagen. Welche Daten für das Audit benötigt werden, klären wir zu Beginn.',
  },
  {
    q: 'Was erhalten wir am Ende des Audits?',
    a: 'Die Ergebnisse werden in einem Auditbericht zusammengeführt. Dazu gehören die Untersuchung des Energieeinsatzes und die Bewertung möglicher Maßnahmen. In der Abschlussbesprechung gehen wir die Erkenntnisse gemeinsam durch. Den genauen Leistungsumfang legen wir im Angebot fest.',
  },
  {
    q: 'Gibt es Fördermöglichkeiten?',
    a: 'Das hängt vom aktuellen Programm, Ihrem Unternehmen und dem Vorhaben ab. Förderfähigkeit und zulässigen Vorhabenbeginn sollten Sie vor einer Beauftragung klären. Eine pauschale Förderzusage lässt sich daraus nicht ableiten.',
  },
];

const faqsRest = [
  {
    q: 'Betreut BESS Consulting unseren Standort?',
    a: 'Das Ingenieurbüro sitzt in Bruchsal. Nennen Sie uns Ihren Standort und Ihr Anliegen, damit wir die mögliche Zusammenarbeit konkret besprechen können.',
  },
  {
    q: 'Findet das Audit bei uns vor Ort statt?',
    a: 'Die Begehung ist Teil des beschriebenen Ablaufs. Sie hilft, Verbrauchsdaten mit den tatsächlichen Anlagen und Arbeitsabläufen abzugleichen. Welche Gespräche ergänzend online stattfinden können, stimmen wir gemeinsam ab.',
  },
  {
    q: 'Können wir mehrere Standorte einbeziehen?',
    a: 'Nennen Sie uns die Standorte und die dort eingesetzten Energieträger. Dann lässt sich klären, welcher Umfang für Ihr Unternehmen erforderlich ist und wie Datenerfassung und Termine organisiert werden können.',
  },
  {
    q: 'Zählt nur unser Stromverbrauch?',
    a: 'Für die Einordnung reicht der Blick auf Strom allein nicht aus. Erfassen Sie auch die weiteren eingesetzten Energieträger und klären Sie, welche Standorte und Einheiten zu betrachten sind.',
  },
  {
    q: 'Was tun, wenn Verbrauchsdaten fehlen?',
    a: 'Bringen Sie zunächst eine Übersicht der vorhandenen Daten und der Lücken mit. Wir klären, welche Informationen sich ergänzen lassen und wo weitere Erhebungen erforderlich sein könnten.',
  },
  {
    q: 'Muss die Produktion für das Audit stillstehen?',
    a: 'Begehung und Datenerfassung werden mit Ihren betrieblichen Abläufen abgestimmt. Ob einzelne Untersuchungen besondere Betriebszustände benötigen, lässt sich erst nach Kenntnis Ihrer Anlagen klären.',
  },
  {
    q: 'Ist eine bestimmte Einsparung garantiert?',
    a: 'Eine pauschale Einspargarantie wäre vor der Analyse nicht belastbar. Erwartete Wirkungen hängen unter anderem von Betriebszeiten, Energiepreisen, technischer Umsetzung und tatsächlicher Nutzung ab.',
  },
  {
    q: 'Profitieren wir automatisch vom Industriestrompreis?',
    a: `Nein. Die Regelung richtet sich an bestimmte energieintensive Branchen. Ein Energieaudit allein begründet keinen Anspruch. <a href="${url('/blog/industriestrompreis-2026/')}">Was die 5-Cent-Marke bedeutet</a>.`,
  },
  {
    q: 'Wie bereiten wir die Beauftragung vor?',
    a: `Klären Sie Anlass, Standorte, verfügbare Daten und gewünschten Umfang. Wenn eine Förderung infrage kommt, prüfen Sie deren Bedingungen vor einer Beauftragung. <a href="${url('/blog/energieaudit-kosten-foerderung-vorbereitung/')}">Checkliste zu Kosten, Förderung und Vorbereitung</a>.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...faqsPrimary, ...faqsRest].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    {indexable && <link rel="canonical" href={siteUrl} />}
    <title>Energieaudit mit Umsetzungsbegleitung | BESS Consulting Bruchsal</title>
    <meta
      name="description"
      content="Energieaudit für Handwerk und produzierende KMU — mit 36 Monaten Begleitung, bis die Einsparung ankommt. Waldemar Brauer, Bruchsal. Blitzaudit ab 2.500 €."
    />
    <meta property="og:title" content="Nicht noch ein Bericht. Sondern das Ergebnis. | BESS Consulting" />
    <meta
      property="og:description"
      content="Über 60 Prozent aller Audit-Empfehlungen werden nie umgesetzt. Waldemar Brauer bleibt an Bord, bis die Einsparung in Ihrer Bilanz steht."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#0e2a33" />
    <script type="application/ld+json" set:html={JSON.stringify(entity)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script src={url('/site.js')} defer></script>
  </head>

  <body>
    <a class="skip" href="#main">Zum Inhalt</a>

    <header class="site-nav">
      <div class="shell nav">
        <a href={url('/')} aria-label="BESS Consulting, zur Startseite">
          <img class="original-logo" src={url('/assets/bess-logo.webp')} alt="BESS Consulting" width="138" height="54" />
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="navlinks">Menü</button>
        <nav class="navlinks" id="navlinks" aria-label="Hauptnavigation">
          <a href="#ergebnis">Ihr Ergebnis</a>
          <a href="#ablauf">Zusammenarbeit</a>
          <a href="#angebote">Angebote</a>
          <a href="#rechner">Größenordnung</a>
          <a href="#waldemar">Waldemar Brauer</a>
          <a href={url('/blog/')}>Wissen &amp; Blog</a>
          <a class="btn btn-primary" href="#kontakt">Audit besprechen</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero: Botschaft links, realer Anlass rechts statt Deko-Mockup -->
      <section class="hero">
        <div class="shell hero-layout">
          <div>
            <p class="eyebrow">Energieberatung für Handwerk und produzierende KMU</p>
            <h1>Nicht noch ein Bericht.<br /><em>Sondern das Ergebnis.</em></h1>
            <p class="lead hero-copy">
              Über 60 Prozent aller Audit-Empfehlungen werden nie umgesetzt. Der Bericht landet
              in der Schublade, die Kosten bleiben. Waldemar Brauer bleibt an Bord, bis die
              Einsparung in Ihrer Bilanz steht.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#kontakt">Erstgespräch vereinbaren</a>
              <a class="textlink" href="#angebote">Die zwei Wege ansehen</a>
            </div>
            <p class="hero-note">BESS Consulting · Bruchsal · Waldemar Brauer, European Energy Manager</p>
          </div>

          <aside class="duty-card" aria-labelledby="duty-title">
            <div class="duty-head">
              <span>Anlass klären</span>
              <span>EDL-G / EnEfG</span>
            </div>
            <h2 class="duty-title" id="duty-title">Betrifft die Pflicht Ihren Betrieb?</h2>
            <p class="duty-lead">
              Zwei Gesetze, zwei Schwellen. Welche für Sie greift, entscheidet sich an
              Unternehmensgröße, Energieverbrauch und vorhandenen Managementsystemen.
            </p>
            <ul class="duty-list">
              <li>
                <span class="duty-marker" aria-hidden="true">1</span>
                <span><strong>Unternehmensstatus</strong>Kein KMU nach EU-Definition? Dann greift das EDL-G.</span>
              </li>
              <li>
                <span class="duty-marker" aria-hidden="true">2</span>
                <span><strong>Gesamtenergieverbrauch</strong>Alle Energieträger zählen, nicht nur Strom.</span>
              </li>
              <li>
                <span class="duty-marker" aria-hidden="true">3</span>
                <span><strong>Vorhandene Systeme</strong>Ein Energie- oder Umweltmanagement kann die Pflicht ersetzen.</span>
              </li>
            </ul>
            <p class="duty-foot">
              Unklar, was für Sie gilt?
              <a href={url('/blog/energieauditpflicht-enefg/')}>Einordnung der Pflichten lesen</a>
            </p>
          </aside>
        </div>
      </section>

      <!-- Trust-Leiste: Einordnung statt Werbeversprechen -->
      <section class="trustbar" aria-label="Einordnung">
        <div class="shell trustbar-grid">
          <div class="trust-item">
            <span class="trust-value">36 Monate</span>
            <span class="trust-label">Begleitung nach dem Audit, nicht nur ein Bericht</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">40+ Audits</span>
            <span class="trust-label">Durchgeführt von Waldemar Brauer, European Energy Manager</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">Förderung inklusive</span>
            <span class="trust-label">BAFA-Antrag übernehmen wir, kein Aufwand für Sie</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">Handwerk &amp; produzierende KMU</span>
            <span class="trust-label">Lackierei, KFZ, Metallbau, Lebensmittel</span>
          </div>
        </div>
      </section>

      <!-- Ergebnisse -->
      <section class="section shell" id="ergebnis">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">01 / Was Sie weiterbringt</p>
            <h2>Was am Ende <em>dabei herauskommt.</em></h2>
          </div>
          <p class="lead">
            Ein gutes Audit beantwortet die Fragen, die für Ihren Betrieb zählen: Wo genauer
            hinsehen? Welche Maßnahmen prüfen? Und welche Investition zuerst angehen?
          </p>
        </div>

        <div class="results">
          {
            results.map((r) => (
              <article class="result reveal">
                <div class="result-top">
                  <span class="result-num">{r.num}</span>
                  <span class="result-symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
                  </span>
                </div>
                <h3>{r.title}</h3>
                <p>{r.copy}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Dunkler Anker: bricht die helle Fläche, nutzt das Industriebild -->
      <section class="anchor-band" aria-labelledby="anchor-title">
        <img class="anchor-photo" src={url('/assets/industrial.webp')} alt="" aria-hidden="true" loading="lazy" decoding="async" />
        <div class="shell anchor-inner">
          <p class="eyebrow">Der Blick auf Ihren Betrieb</p>
          <h2 id="anchor-title">Energie verschwindet dort, <em>wo niemand hinsieht.</em></h2>
          <p class="anchor-lead">
            Die Verluste liegen selten an einer einzigen Stelle. Sie verteilen sich über
            Betriebszeiten, Regelung und Anlagen, die seit Jahren unverändert laufen. Genau
            dort setzt die Untersuchung an.
          </p>
          <ul class="anchor-fields">
            {
              fields.map((f) => (
                <li>
                  <strong>{f.name}</strong>
                  <span>{f.copy}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Angebote: der eigentliche Blue Ocean -->
      <section class="section shell" id="angebote">
        <div class="section-head reveal">
          <div>
            <p class="eyebrow">02 / Zwei Wege</p>
            <h2>Schnell anfangen oder <em>bis zum Ergebnis gehen.</em></h2>
          </div>
          <p class="lead">
            Beide Wege beginnen im Betrieb, nicht am Schreibtisch. Der Unterschied liegt darin,
            wie weit wir mitgehen.
          </p>
        </div>

        <div class="offers">
          {
            angebote.map((a) => (
              <article class={a.featured ? 'offer is-featured reveal' : 'offer reveal'}>
                <span class="offer-tag">{a.tag}</span>
                <h3>{a.name}</h3>
                <p class="offer-lead">{a.lead}</p>
                <ul class="offer-points">
                  {a.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <div class="offer-price">
                  <strong>{a.price}</strong>
                  <span>{a.priceNote}</span>
                </div>
                <a class={a.featured ? 'btn btn-leaf' : 'btn btn-ghost'} href="#kontakt">
                  {a.cta}
                </a>
              </article>
            ))
          }
        </div>

        <div class="branchen reveal">
          <p class="branchen-intro">
            <strong>Branchenmodule.</strong> Gleiche Norm, andere Sprache: Ein Lackierer hat andere
            Fragen als ein Bürogebäude.
          </p>
          <ul>
            {
              branchen.map((b) => (
                <li>
                  <strong>{b.name}</strong>
                  <span>{b.copy}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Ablauf -->
      <section class="method section" id="ablauf">
        <div class="shell method-grid">
          <div class="reveal">
            <p class="eyebrow">02 / Die Zusammenarbeit</p>
            <h2>Wir beginnen dort, wo Sie <em>Energie einsetzen.</em></h2>
            <p class="lead method-intro">
              Sie kennen Ihren Betrieb. BESS Consulting bringt den systematischen Blick auf Ihren
              Energieeinsatz ein. Ziele, Datenbedarf und Umfang stimmen wir zu Beginn ab.
            </p>
            <p class="prep">
              <strong>Gut für das erste Gespräch</strong>
              Standorte, Energieträger, vorhandene Verbrauchsdaten und Ihr konkretes Anliegen.
            </p>
          </div>

          <ol class="steps reveal" style="list-style:none;margin:0;padding:0">
            {
              steps.map((s) => (
                <li class="step">
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.copy}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Rechner: ersetzt das Deko-Mockup durch etwas Rechenbares -->
      <section class="section shell" id="rechner">
        <div class="calc-wrap">
          <div class="reveal">
            <p class="eyebrow">03 / Größenordnung</p>
            <h2>Womit reden wir <em>überhaupt?</em></h2>
            <p class="lead" style="margin-top:var(--s3);max-width:46ch">
              Bevor über Maßnahmen gesprochen wird, hilft eine grobe Einordnung: Wie viel Geld
              läuft im Jahr durch Ihren Energieeinsatz? Tragen Sie Ihre Zahlen ein.
            </p>
            <p class="lead" style="margin-top:var(--s3);max-width:46ch;font-size:16px">
              Die Rechnung ersetzt keine Analyse. Sie zeigt nur, in welcher Größenordnung sich
              eine Veränderung bewegen würde.
            </p>
          </div>

          <div class="calc reveal">
            <div class="calc-field">
              <label for="calc-kwh">Stromverbrauch im Jahr</label>
              <div class="calc-input">
                <input
                  id="calc-kwh"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max="500000000"
                  step="1000"
                  value="750000"
                  aria-describedby="calc-kwh-hint"
                />
                <span class="unit">kWh</span>
              </div>
              <span class="hint" id="calc-kwh-hint">Steht auf Ihrer Jahresabrechnung.</span>
            </div>

            <div class="calc-field">
              <label for="calc-price">Arbeitspreis</label>
              <div class="calc-input">
                <input
                  id="calc-price"
                  type="number"
                  inputmode="decimal"
                  min="0"
                  max="200"
                  step="0.5"
                  value="18"
                  aria-describedby="calc-price-hint"
                />
                <span class="unit">ct/kWh</span>
              </div>
              <span class="hint" id="calc-price-hint">Ihr durchschnittlicher Bezugspreis.</span>
            </div>

            <div class="calc-field">
              <label for="calc-share">Angenommene Veränderung</label>
              <div class="calc-input">
                <input
                  id="calc-share"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max="100"
                  step="1"
                  value="8"
                  aria-describedby="calc-share-hint"
                />
                <span class="unit">%</span>
              </div>
              <span class="hint" id="calc-share-hint">Frei gewählter Wert, keine Prognose.</span>
            </div>

            <dl class="calc-out" aria-live="polite">
              <div class="calc-row">
                <dt>Stromkosten im Jahr</dt>
                <dd id="out-total">—</dd>
              </div>
              <div class="calc-row is-major">
                <dt>Rechnerische Differenz</dt>
