    <script>
      // Mobile Navigation
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
      const navlinks = document.getElementById('navlinks');
      menuButton?.addEventListener('click', () => {
        const open = navlinks?.classList.toggle('open') ?? false;
        menuButton.setAttribute('aria-expanded', String(open));
      });
      navlinks?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          navlinks.classList.remove('open');
          menuButton?.setAttribute('aria-expanded', 'false');
        });
      });

      // FAQ: restliche Fragen einblenden
      const faqToggle = document.getElementById('faq-toggle');
      const faqRest = document.getElementById('faq-rest');
      faqToggle?.addEventListener('click', () => {
        const willShow = faqRest?.hasAttribute('hidden') ?? false;
        if (willShow) faqRest?.removeAttribute('hidden');
        else faqRest?.setAttribute('hidden', '');
        faqToggle.setAttribute('aria-expanded', String(willShow));
        faqToggle.textContent = willShow ? 'Weitere Fragen ausblenden' : 'Weitere neun Fragen anzeigen';
      });

      // Größenordnungs-Rechner.
      // Eingaben werden geklemmt und ausschliesslich über textContent ausgegeben.
      const MAX_KWH = 500_000_000;
      const MAX_CT = 200;
      const MAX_PCT = 100;

      const euro = new Intl.NumberFormat('de-DE', {
        style: 'currency',
        currency: 'EUR',
        maximumFractionDigits: 0,
      });

      const clamp = (raw: string, max: number) => {
        const value = Number.parseFloat(raw.replace(',', '.'));
        if (!Number.isFinite(value) || value < 0) return 0;
        return Math.min(value, max);
      };

      const kwhInput = document.getElementById('calc-kwh') as HTMLInputElement | null;
      const priceInput = document.getElementById('calc-price') as HTMLInputElement | null;
      const shareInput = document.getElementById('calc-share') as HTMLInputElement | null;
      const outTotal = document.getElementById('out-total');
      const outSaving = document.getElementById('out-saving');

      const recalc = () => {
        if (!kwhInput || !priceInput || !shareInput || !outTotal || !outSaving) return;
        const kwh = clamp(kwhInput.value, MAX_KWH);
        const centPerKwh = clamp(priceInput.value, MAX_CT);
        const sharePercent = clamp(shareInput.value, MAX_PCT);

        const total = (kwh * centPerKwh) / 100;
        outTotal.textContent = euro.format(total);
        outSaving.textContent = euro.format((total * sharePercent) / 100);
      };

      [kwhInput, priceInput, shareInput].forEach((el) => el?.addEventListener('input', recalc));
      recalc();

      // Scroll-Reveal, nur wenn der Nutzer Bewegung zulässt
      const wantsMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealables = document.querySelectorAll('.reveal');
      if (wantsMotion && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-in');
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 },
        );
        revealables.forEach((el) => observer.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-in'));
      }
    </script>
