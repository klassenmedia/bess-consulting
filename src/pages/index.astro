---
import { url } from '../lib/url';
import '@fontsource-variable/manrope';
import '../styles/global.css';

const indexable = import.meta.env.PUBLIC_INDEXABLE === 'true';
const siteUrl = 'https://bess-consulting.de/';

const entity = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'BESS Consulting',
  url: siteUrl,
  logo: siteUrl + 'assets/bess-logo.webp',
  telephone: '+4972579251838',
  email: 'kontakt@bess-consulting.de',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Rudolf-Diesel-Straße 14/1',
    postalCode: '76356',
    addressLocality: 'Weingarten (Baden)',
    addressCountry: 'DE',
  },
  founder: { '@type': 'Person', name: 'Waldemar Brauer' },
  description: 'Energieaudit nach DIN EN 16247-1 mit Umsetzungsbegleitung, Abwärmeberatung und Energie-Quickchecks. Ingenieurbüro für nachhaltige Unternehmenslösungen.',
