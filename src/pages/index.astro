const results = [
  {
    num: '01 / Verstehen',
    title: 'Eine Übersicht Ihres Energieeinsatzes',
    copy: 'Verbräuche, Energieträger und wesentliche Anlagen im Zusammenhang betrachten. Damit sichtbar wird, wo eine vertiefte Analyse ansetzt.',
    icon: '<path d="M3 3v18h18"/><path d="m7 15 4-5 3 3 5-7"/>',
  },
  {
    num: '02 / Bewerten',
    title: 'Eine Bewertung möglicher Maßnahmen',
    copy: 'Effizienzmaßnahmen nach technischem Potenzial, Investitionsbedarf und erwartetem Nutzen einordnen. Mit offengelegten Annahmen.',
    icon: '<path d="M12 3v18"/><path d="M5 7h14"/><path d="m5 7-2 6a3.2 3.2 0 0 0 4 0Z"/><path d="m19 7 2 6a3.2 3.2 0 0 1-4 0Z"/>',
  },
  {
    num: '03 / Umsetzen',
    title: 'Jemanden, der dranbleibt',
    copy: 'Der Bericht ist der Anfang, nicht das Ende. Bei Rückfragen zur Umsetzung, zu Förderungen oder zur nächsten Prüfung sind wir weiter erreichbar.',
    icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5"/><path d="M9 14h6"/><path d="M9 17h4"/>',
  },
];

const angebote = [
  {
    tag: 'Der schnelle Einstieg',
    name: 'Energie-Quickcheck',
    price: 'auf Anfrage',
    priceNote: 'zzgl. USt. und Reisekosten · In Baden-Württemberg über EnergizeBW förderfähig, bei der Antragstellung unterstützen wir kostenlos',
    lead: 'Online-Abstimmung, ein Tag Begehung, danach ein Maßnahmen- und Investitionsplan mit Rangfolge. Für Betriebe, die Kosten senken wollen — nicht für die Pflicht.',
    points: [
      'Mindestens 20.000 € Einsparpotenzial pro Jahr als Zielgröße',
      'Quick-Wins zuerst: nicht- und geringinvestive Maßnahmen',
      'Investitionsbedarf, Amortisation und Renditekennzahlen je Maßnahme',
    ],
    cta: 'Quickcheck besprechen',
    featured: false,
  },
  {
    tag: 'Die Pflicht erfüllen',
    name: 'Energieaudit nach DIN EN 16247-1',
    price: 'ab 4.800 €',
    priceNote: 'zzgl. USt. und Reisekosten · Bis 5 GWh Jahresverbrauch 4.800 €, darüber 5.800 € · Mehrere Standorte auf Anfrage',
    lead: 'Das vollständige Audit nach Norm: Begehung, Analyse, Bericht und Abschlussbesprechung. Erfüllt die Pflicht nach EDL-G.',
    points: [
      'Mindestens 90 Prozent des Gesamtverbrauchs untersucht',
      'Bewertung nach Kapitalwert, nicht nach einfacher Amortisation',
      'Angaben für die BAFA-Meldung aufbereitet',
    ],
    cta: 'Audit besprechen',
    featured: false,
  },
  {
    tag: 'Das Rundum-Paket',
    name: 'Audit + 48 Monate Begleitung',
    price: 'ca. 8.500 €',
    priceNote: 'zzgl. USt. und Reisekosten · Eine Förderung kann den Eigenanteil senken. Was für Sie infrage kommt, prüfen wir vor der Beauftragung.',
    lead: 'Das vollständige Energieaudit — und danach vier Jahre erreichbar bleiben: für Rückfragen zur Umsetzung, zu Förderungen und zur nächsten Prüfung.',
    points: [
      'Ansprechpartner für Rückfragen über den gesamten Prüfzyklus',
      'Unterstützung bei Förderanträgen und Nachweisen',
      'Waldemar Brauer persönlich, kein wechselndes Personal',
    ],
    cta: 'Kernprodukt besprechen',
    featured: true,
  },
];
const multiSite = [
  {
    schritt: '01',
    titel: 'Alle Standorte erfassen',
    copy: 'Der gesamte Energieverbrauch über sämtliche Standorte wird aufgenommen — das ist die Bezugsgröße für alles Weitere.',
  },
  {
    schritt: '02',
    titel: 'Kleine Standorte ausgrenzen',
    copy: 'Standorte, die zusammen unter zehn Prozent des Gesamtverbrauchs liegen, bleiben unberücksichtigt.',
  },
  {
    schritt: '03',
    titel: 'Vergleichbares clustern',
    copy: 'Ähnliche Standorte werden gruppiert. Untersucht wird die Wurzel aus der Anzahl je Cluster, aufgerundet auf die nächste ganze Zahl. Bei drei Standorten sind das zwei, bei neun drei.',
  },
  {
    schritt: '04',
    titel: 'Besondere einzeln prüfen',
    copy: 'Standorte, die sich nicht einordnen lassen, werden separat betrachtet — dort steckt oft das größte Potenzial.',
  },
];

const branchen = [
  { name: 'Lackierereien', copy: 'Trockenkabinen, Abluft, Druckluft.' },
  { name: 'KFZ-Werkstätten', copy: 'Hebebühnen, Druckluft, Hallenwärme.' },
  { name: 'Metallbau & CNC', copy: 'Kühlwasser, Werkzeugmaschinen, Absaugung.' },
  { name: 'Lebensmittelverarbeitung', copy: 'Kälte, Hygienewärme, Betriebszeiten.' },
];

const fields = [
  { name: 'Produktion & Anlagen', copy: 'Betriebszeiten, Lastgänge und die Technik dahinter.' },
  { name: 'Wärme & Abwärme', copy: 'Erzeugung, Verteilung und ungenutzte Wärmeströme.' },
  { name: 'Druckluft & Kälte', copy: 'Erzeugung, Leckagen und Druckniveaus im Betrieb.' },
  { name: 'Antriebe & Beleuchtung', copy: 'Motoren, Regelung und Beleuchtung in den Hallen.' },
];

const steps = [
  {
    title: 'Den richtigen Rahmen setzen',
    copy: 'Wir besprechen Ihren Anlass, die relevanten Standorte und Ihre Datenlage. Daraus entsteht ein passender Leistungsumfang.',
  },
  {
    title: 'Daten mit der Praxis verbinden',
    copy: 'Verbrauchsübersichten und die Begehung vor Ort helfen, Anlagen und Abläufe im Zusammenhang zu verstehen.',
  },
  {
    title: 'Potenziale wirtschaftlich einordnen',
    copy: 'Wir analysieren mögliche Maßnahmen und betrachten Investition, Nutzen und zugrunde liegende Annahmen.',
  },
  {
    title: 'Dranbleiben, bis es wirkt',
    copy: 'Sie erhalten den Auditbericht und die Datengrundlage. Danach bleiben wir für Rückfragen erreichbar — zur Umsetzung, zu Förderungen und zur nächsten Prüfung.',
  },
];

// Die ersten sechs stehen offen sichtbar, der Rest liegt hinter dem Umschalter.
const faqsPrimary = [
  {
    q: 'Was kostet ein Energieaudit?',
    a: 'Der Aufwand hängt unter anderem von Standorten, Anlagen, Datenlage und Leistungsumfang ab. Nach einer ersten Abstimmung lässt sich ein individuelles Angebot erstellen.',
  },
  {
    q: 'Sind wir zu einem Energieaudit verpflichtet?',
    a: `Das muss anhand Ihres Unternehmensstatus, Energieverbrauchs und vorhandener Managementsysteme geprüft werden. EDL-G und EnEfG haben unterschiedliche Anforderungen. Hinzu kommt: Eine Novelle beider Gesetze ist beschlossen, aber noch nicht in Kraft — sie verschiebt die Schwellen und stellt die Auditpflicht vom Unternehmensstatus auf den Energieverbrauch um. <a href="${url('/blog/energieauditpflicht-enefg/')}">Zur Einordnung der Pflichten</a>.`,
  },
  {
    q: 'Ab welcher Unternehmensgröße gilt die Auditpflicht?',
    a: 'Das EDL-G erfasst nach § 1 Nummer 4 Unternehmen, die keine KMU im Sinne der EU-Empfehlung 2003/361/EG sind. KMU ist, wer weniger als 250 Personen beschäftigt und dabei entweder höchstens 50 Millionen Euro Umsatz oder höchstens 43 Millionen Euro Bilanzsumme erreicht. Wichtig: Bei verbundenen und Partnerunternehmen werden die Werte zusammengerechnet — eine kleine GmbH im Konzern kann den KMU-Status verlieren.',
  },
  {
    q: 'Was passiert, wenn wir die Frist verstreichen lassen?',
    a: 'Das EDL-G sieht Bußgelder bis 50.000 Euro vor, das EnEfG bis 100.000 Euro für ein fehlendes Energiemanagementsystem und bis 50.000 Euro für fehlende Umsetzungspläne. Eine unterlassene Durchführung ist eine Dauerordnungswidrigkeit — die Pflicht bleibt bestehen, und es sind mehrere Bescheide möglich. Fristverlängerungen sieht das Gesetz nicht vor. Wer bereits überfällig ist, sollte den Ablauf dokumentieren: Das BAFA prüft Verschulden und Zumutbarkeit, der Spielraum wird mit der Zeit aber kleiner.',
  },
  {
    q: 'Wie viel Zeit müssen wir intern einplanen?',
    a: 'Ein Ansprechpartner im Unternehmen, verfügbare Verbrauchsdaten und Zugang zu den relevanten Anlagen erleichtern die Zusammenarbeit. Den konkreten Zeitbedarf stimmen wir anhand Ihres Betriebs und des vereinbarten Umfangs ab.',
  },
  {
    q: 'Was erhalten wir am Ende des Audits?',
    a: 'Die Ergebnisse werden in einem Auditbericht zusammengeführt. Dazu gehören die Untersuchung des Energieeinsatzes und die Bewertung möglicher Maßnahmen. In der Abschlussbesprechung gehen wir die Erkenntnisse gemeinsam durch. Den genauen Leistungsumfang legen wir im Angebot fest.',
  },
];

const faqsRest = [
  {
    q: 'Welche Unterlagen werden benötigt?',
    a: 'Hilfreich sind Energieabrechnungen, Verbrauchsübersichten sowie Informationen zu Standorten und wesentlichen Anlagen. Welche Daten für das Audit benötigt werden, klären wir zu Beginn.',
  },
  {
    q: 'Nach welchen Regeln wird das Audit durchgeführt?',
    a: 'Maßgeblich ist § 8a EDL-G. Er verlangt ein Audit nach DIN EN 16247-1 in der Ausgabe November 2022, gestützt auf belegbare Betriebsdaten, und eine Bewertung mindestens nach der Kapitalwertmethode. Häufig missverstanden wird die 90-Prozent-Regel: Der Gesamtenergieverbrauch ist immer vollständig zu erfassen — die 90 Prozent betreffen nur die Tiefe der Detailanalyse. Welche zehn Prozent Sie herausnehmen, entscheiden Sie.',
  },
  {
    q: 'Zählen unsere Auslandsstandorte mit?',
    a: 'Für die Frage, ob Sie verpflichtet sind, ja: Beteiligungen und verbundene Unternehmen zählen mit, unabhängig davon, ob sie in Deutschland, der EU oder einem Drittland sitzen. Für die Durchführung des Audits selbst nein — dort werden nur die Standorte in Deutschland untersucht. Diese Unterscheidung wird oft übersehen.',
  },
  {
    q: 'Werden alte, nie umgesetzte Maßnahmen wieder aufgegriffen?',
    a: 'Ja, das ist sogar vorgeschrieben. Maßnahmen aus früheren Audits, die nicht umgesetzt wurden, gehören erneut in die Übersicht, werden hervorgehoben, bei Bedarf neu gerechnet und mit den aktuellen Förderprogrammen abgeglichen. Genau hier liegt oft ungenutztes Potenzial.',
  },
  {
    q: 'Gehört der Fuhrpark auch dazu?',
    a: 'Ja. Der Gesamtenergieverbrauch umfasst alle Energieträger und alle Standorte einschließlich der Beförderung — auch Verkaufs-, Verwaltungs- und Lagerräume. Fuhrpark und Nebenflächen werden häufig vergessen, gehören aber in die Bilanz. Bei vielen vergleichbaren Fahrzeugen genügt die Untersuchung einer repräsentativen Auswahl.',
  },
  {
    q: 'Wann gilt eine Maßnahme als wirtschaftlich?',
    a: 'Das ist in § 9 EnEfG definiert: Eine Maßnahme gilt als wirtschaftlich, wenn sich bei der Betrachtung nach DIN EN 17463 nach höchstens der Hälfte der Nutzungsdauer ein positiver Kapitalwert ergibt — begrenzt auf Maßnahmen mit einer Nutzungsdauer von maximal fünfzehn Jahren. Für die Nutzungsdauer sind die Abschreibungstabellen des Bundesfinanzministeriums maßgeblich. Bewusst nicht maßgeblich ist die einfache Amortisationszeit: Sie blendet die Lebensdauer der Investition aus und gilt nach dem BAFA-Leitfaden als ungeeignetes Kriterium.',
  },
  {
    q: 'Wer bestätigt unseren Umsetzungsplan?',
    a: 'Unternehmen oberhalb von 2,5 Gigawattstunden müssen Umsetzungspläne erstellen, veröffentlichen und sich Vollständigkeit und Richtigkeit vor der Veröffentlichung bestätigen lassen — durch Zertifizierer, Umweltgutachter oder zugelassene Energieauditoren. Die Bestätigung muss von einem unabhängigen Dritten kommen: Wer die Maßnahmen bewertet hat, darf sie nicht selbst bestätigen. Für Ihr eigenes Audit brauchen Sie also jemand anderen — umgekehrt übernimmt Waldemar Brauer diese Prüfung für Audits, die nicht von ihm stammen.',
  },
  {
    q: 'Müssen wir das Audit beim BAFA melden?',
    a: 'Ja. Nach § 8c EDL-G ist spätestens zwei Monate nach Durchführung eine Erklärung über eine elektronische Eingabemaske zu übermitteln: Angaben zum Unternehmen und zur auditierenden Person, der Gesamtenergieverbrauch nach Energieträgern, die Energiekosten, die vorgeschlagenen Maßnahmen mit Investitionskosten, Nutzungsdauer und erwarteter Einsparung sowie die Kosten des Audits. Die dafür nötigen Angaben bereiten wir mit dem Bericht so auf, dass Sie sie direkt übernehmen können.',
  },
  {
    q: 'Bekommen wir die Daten oder nur den Bericht?',
    a: 'Beides. § 8a Absatz 2 EDL-G verlangt, dass die verwendeten Daten so übergeben werden, dass Sie sie für historische Analysen und die Rückverfolgung der Entwicklung aufbewahren können. Sie erhalten die Auswertungsgrundlage, nicht nur ein abgeschlossenes PDF.',
  },
  {
    q: 'Gibt es Fördermöglichkeiten?',
    a: 'Für Pflichtaudits nach EDL-G gibt es laut BAFA keine Förderung — die Durchführung ist gesetzlich vorgeschrieben. Eine Ausnahme nennt das BAFA für Unternehmen mit höchstens 500.000 Kilowattstunden Jahresverbrauch: Dort kommt eine Förderung über die Richtlinie Energieberatung für Nichtwohngebäude, Anlagen und Systeme in Betracht. Für freiwillige Beratungsleistungen gelten eigene Programme. Was für Sie infrage kommt, klären wir vor der Beauftragung — eine pauschale Zusage lässt sich daraus nicht ableiten.',
  },
  {
    q: 'Betreut BESS Consulting unseren Standort?',
    a: 'Das Ingenieurbüro sitzt in Weingarten (Baden) bei Karlsruhe, arbeitet aber überregional. Über 90 Projekte wurden in Deutschland, Österreich, der Schweiz und Mazedonien begleitet. Nennen Sie uns Ihren Standort und Ihr Anliegen, dann klären wir die Zusammenarbeit konkret.',
  },
  {
    q: 'Findet das Audit bei uns vor Ort statt?',
    a: 'Die Begehung ist Teil des beschriebenen Ablaufs. Sie hilft, Verbrauchsdaten mit den tatsächlichen Anlagen und Arbeitsabläufen abzugleichen. Welche Gespräche ergänzend online stattfinden können, stimmen wir gemeinsam ab.',
  },
  {
    q: 'Müssen wir wirklich jeden Standort auditieren?',
    a: 'In der Regel nicht. Das vom BAFA beschriebene Multi-Site-Verfahren erlaubt es, vergleichbare Standorte zu Clustern zusammenzufassen und daraus eine Stichprobe zu untersuchen — die Wurzel aus der Anzahl der Standorte je Cluster, aufgerundet auf die nächste ganze Zahl. Standorte, die zusammen unter zehn Prozent des Gesamtverbrauchs liegen, bleiben unberücksichtigt; nicht vergleichbare Standorte werden einzeln betrachtet. Im BAFA-Beispiel reduziert das zwölf Standorte auf sechs zu untersuchende. Wichtig: Das Verfahren setzt vergleichbare Standorte voraus und ist bei Produktionsstätten und Krankenhäusern meist nicht anwendbar. Der Gesamtenergieverbrauch bleibt in jedem Fall vollständig zu erfassen.',
  },
  {
    q: 'Können wir mehrere Standorte einbeziehen?',
    a: 'Nennen Sie uns die Standorte und die dort eingesetzten Energieträger. Dann lässt sich klären, welcher Umfang für Ihr Unternehmen erforderlich ist und wie Datenerfassung und Termine organisiert werden können.',
  },
  {
    q: 'Zählt nur unser Stromverbrauch?',
    a: 'Für die Einordnung reicht der Blick auf Strom allein nicht aus. Erfassen Sie auch die weiteren eingesetzten Energieträger und klären Sie, welche Standorte und Einheiten zu betrachten sind.',
  },
  {
    q: 'Was tun, wenn Verbrauchsdaten fehlen?',
    a: 'Bringen Sie zunächst eine Übersicht der vorhandenen Daten und der Lücken mit. Wir klären, welche Informationen sich ergänzen lassen und wo weitere Erhebungen erforderlich sein könnten.',
  },
  {
    q: 'Muss die Produktion für das Audit stillstehen?',
    a: 'Begehung und Datenerfassung werden mit Ihren betrieblichen Abläufen abgestimmt. Ob einzelne Untersuchungen besondere Betriebszustände benötigen, lässt sich erst nach Kenntnis Ihrer Anlagen klären.',
  },
  {
    q: 'Ist eine bestimmte Einsparung garantiert?',
    a: 'Für den Energie-Quickcheck gibt es eine Einsparpotenzialgarantie: Finden wir nicht genügend nicht- oder geringinvestive Maßnahmen mit einer Amortisation unter einem Jahr, verzichten wir auf die Rechnungsstellung. Sie gilt ab 200.000 Euro Energiekosten pro Jahr und bezieht sich auf die ermittelten Maßnahmen. Eine Garantie auf die tatsächlich erzielte Einsparung wäre dagegen nicht belastbar — die hängt von Umsetzung, Betriebszeiten, Energiepreisen und Nutzung ab.',
  },
  {
    q: 'Profitieren wir automatisch vom Industriestrompreis?',
    a: `Nein. Die Regelung richtet sich an bestimmte energieintensive Branchen. Ein Energieaudit allein begründet keinen Anspruch. <a href="${url('/blog/industriestrompreis-2026/')}">Was die 5-Cent-Marke bedeutet</a>.`,
  },
  {
    q: 'Wie bereiten wir die Beauftragung vor?',
    a: `Klären Sie Anlass, Standorte, verfügbare Daten und gewünschten Umfang. Wenn eine Förderung infrage kommt, prüfen Sie deren Bedingungen vor einer Beauftragung. <a href="${url('/blog/energieaudit-kosten-foerderung-vorbereitung/')}">Checkliste zu Kosten, Förderung und Vorbereitung</a>.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [...faqsPrimary, ...faqsRest].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
  })),
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content={indexable ? 'index,follow' : 'noindex,follow'} />
    {indexable && <link rel="canonical" href={siteUrl} />}
    <title>Energieaudit und Abwärmeberatung | BESS Consulting</title>
    <meta
      name="description"
      content="Energieaudit, Abwärmeberatung und Energie-Quickchecks mit Umsetzungsbegleitung. Über 50 Audits nach DIN EN 16247-1, über 90 Projekte in DACH. Waldemar Brauer, BESS Consulting."
    />
    <meta property="og:title" content="Nicht noch ein Bericht. Sondern das Ergebnis. | BESS Consulting" />
    <meta
      property="og:description"
      content="Die Mehrheit aller Audit-Empfehlungen wird nie umgesetzt. Waldemar Brauer bleibt an Bord, bis die Einsparung in Ihrer Bilanz steht."
    />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta name="theme-color" content="#0e2a33" />
    <script type="application/ld+json" set:html={JSON.stringify(entity)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    
  </head>

  <body>
    <a class="skip" href="#main">Zum Inhalt</a>

    <header class="site-nav">
      <div class="shell nav">
        <a href={url('/')} aria-label="BESS Consulting, zur Startseite">
          <img class="original-logo" src={url('/assets/bess-logo.webp')} alt="BESS Consulting" width="138" height="54" />
        </a>
        <button class="menu-button" type="button" aria-expanded="false" aria-controls="navlinks">Menü</button>
        <nav class="navlinks" id="navlinks" aria-label="Hauptnavigation">
          <a href="#angebote">Angebote</a>
          <a href="#ablauf">Ablauf</a>
          <a href="#standorte">Standorte</a>
          <a href="#waldemar">Waldemar Brauer</a>
          <a href={url('/blog/')}>Wissen</a>
          <a class="btn btn-primary" href="#termin" data-magnet><span class="magnet-inner">Termin buchen</span></a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero: Botschaft links, realer Anlass rechts statt Deko-Mockup -->
      <section class="hero">
        <div class="hero-layout" data-parallax-bereich>
          <div class="hero-text">
            <p class="eyebrow">Energieaudit und Umsetzungsbegleitung für Unternehmen</p>
            <h1 data-reveal-text>
              <span class="zeile"><span class="zeile-inner">Nicht noch ein Bericht.</span></span>
              <span class="zeile"><span class="zeile-inner"><em>Sondern das Ergebnis.</em></span></span>
            </h1>
            <p class="lead hero-copy">
              Die Mehrheit aller Audit-Empfehlungen wird nie umgesetzt. Der Bericht landet
              in der Schublade, die Kosten bleiben. Wir bleiben ansprechbar, bis die
              Maßnahmen laufen.
            </p>
            <p class="hero-source">
              Erhebung des EEP der Universität Stuttgart mit Fraunhofer IPA unter 3.270
              Energieauditoren, 2016: Umsetzungsquote deutlich unter einem Drittel.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#kontakt" data-magnet><span class="magnet-inner">Erstgespräch vereinbaren</span></a>
              <a class="textlink" href="#angebote">Die zwei Wege ansehen</a>
            </div>
            <p class="hero-note">BESS Consulting · Waldemar Brauer, M.Sc. · European EnergyManager · Energieeffizienz-Experte (BAFA)</p>
          </div>

          <aside class="duty-card" aria-labelledby="duty-title" data-tilt="5" data-parallax="-0.06">
            <div class="duty-head">
              <span>Anlass klären</span>
              <span>EDL-G / EnEfG</span>
            </div>
            <h2 class="duty-title" id="duty-title">Betrifft die Pflicht Ihren Betrieb?</h2>
            <p class="duty-lead">
              Drei Angaben genügen für eine erste Einordnung.
            </p>

            <ol class="duty-check">
              <li>
                <div class="duty-check-head">
                  <span class="duty-step" aria-hidden="true">1</span>
                  <strong>Wie groß ist Ihr Unternehmen?</strong>
                </div>
                <div class="duty-values">
                  <span class="duty-value"><b>250</b>Beschäftigte</span>
                  <span class="duty-op" aria-hidden="true">oder</span>
                  <span class="duty-value"><b>50 Mio. €</b>Umsatz</span>
                  <span class="duty-op" aria-hidden="true">+</span>
                  <span class="duty-value"><b>43 Mio. €</b>Bilanzsumme</span>
                </div>
                <p class="duty-note">Ab 250 Beschäftigten greift das EDL-G. Darunter nur, wenn beide Finanzwerte überschritten sind. Verbundene Unternehmen zählen mit.</p>
              </li>

              <li>
                <div class="duty-check-head">
                  <span class="duty-step" aria-hidden="true">2</span>
                  <strong>Wie viel Energie setzen Sie ein?</strong>
                </div>
                <div class="duty-values">
                  <span class="duty-value"><b>2,5 GWh</b>Umsetzungsplan</span>
                  <span class="duty-op" aria-hidden="true">→</span>
                  <span class="duty-value"><b>7,5 GWh</b>Managementsystem</span>
                </div>
                <p class="duty-note">Alle Energieträger zusammen, nicht nur Strom. Schwellen nach EnEfG.</p>
              </li>

              <li>
                <div class="duty-check-head">
                  <span class="duty-step" aria-hidden="true">3</span>
                  <strong>Haben Sie ein Managementsystem?</strong>
                </div>
                <div class="duty-values">
                  <span class="duty-value is-plain">ISO 50001</span>
                  <span class="duty-op" aria-hidden="true">oder</span>
                  <span class="duty-value is-plain">EMAS</span>
                </div>
                <p class="duty-note">Ein anerkanntes System kann die Auditpflicht ersetzen.</p>
              </li>
            </ol>

            <p class="duty-foot">
              <span class="duty-flag">Novelle beschlossen</span>
              Die Schwellen verschieben sich, sobald die Gesetzesänderung in Kraft tritt.
              <a href={url('/blog/energieauditpflicht-enefg/')}>Einordnung der Pflichten lesen</a>
            </p>
          </aside>
        </div>
      </section>

      <!-- Trust-Leiste: Einordnung statt Werbeversprechen -->
      <section class="trustbar" aria-label="Einordnung">
        <div class="shell trustbar-grid">
          <div class="trust-item">
            <span class="trust-value">48 Monate</span>
            <span class="trust-label">Erreichbar bis zur nächsten Prüfung, nicht nur bis zum Bericht</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">50+ Energieaudits</span>
            <span class="trust-label">Nach DIN EN 16247-1, dazu über 90 Projekte in DACH und Mazedonien</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">Förderung mitgedacht</span>
            <span class="trust-label">Wir prüfen die Möglichkeiten und übernehmen die Antragstellung</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">Branchenkenntnis</span>
            <span class="trust-label">Produktion, Handwerk, Gebäude und Anlagentechnik</span>
          </div>
        </div>
      </section>

      <!-- Ergebnisse -->
      <section class="section shell" id="ergebnis">
        <div class="section-head" data-reveal data-reveal-stagger>
          <div>
            <p class="eyebrow">01 / Was Sie weiterbringt</p>
            <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Was am Ende</span></span><span class="zeile"><span class="zeile-inner"><em>dabei herauskommt.</em></span></span></h2>
          </div>
          <p class="lead">
            Ein gutes Audit beantwortet die Fragen, die für Ihren Betrieb zählen: Wo genauer
            hinsehen? Welche Maßnahmen prüfen? Und welche Investition zuerst angehen?
          </p>
        </div>

        <div class="results">
          {
            results.map((r) => (
              <article class="result" data-reveal>
                <div class="result-top">
                  <span class="result-num">{r.num}</span>
                  <span class="result-symbol" aria-hidden="true">
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round" set:html={r.icon} />
                  </span>
                </div>
                <h3>{r.title}</h3>
                <p>{r.copy}</p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Dunkler Anker: bricht die helle Fläche, nutzt das Industriebild -->
      <section class="anchor-band" aria-labelledby="anchor-title" data-parallax-bereich>
        <img class="anchor-photo" src={url('/assets/industrial.webp')} alt="" aria-hidden="true" loading="lazy" decoding="async" data-parallax="0.14" />
        <div class="shell anchor-inner">
          <p class="eyebrow">Der Blick auf Ihren Betrieb</p>
          <h2 id="anchor-title" data-reveal-text><span class="zeile"><span class="zeile-inner">Energie verschwindet dort,</span></span><span class="zeile"><span class="zeile-inner"><em>wo niemand hinsieht.</em></span></span></h2>
          <p class="anchor-lead">
            Die Verluste liegen selten an einer einzigen Stelle. Sie verteilen sich über
            Betriebszeiten, Regelung und Anlagen, die seit Jahren unverändert laufen. Genau
            dort setzt die Untersuchung an.
          </p>
          <ul class="anchor-fields">
            {
              fields.map((f) => (
                <li>
                  <strong>{f.name}</strong>
                  <span>{f.copy}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Angebote: der eigentliche Blue Ocean -->
      <section class="section shell" id="angebote">
        <div class="section-head" data-reveal data-reveal-stagger>
          <div>
            <p class="eyebrow">02 / Zwei Wege</p>
            <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Schnell anfangen oder</span></span><span class="zeile"><span class="zeile-inner"><em>bis zum Ergebnis gehen.</em></span></span></h2>
          </div>
          <p class="lead">
            Beide Wege beginnen im Betrieb, nicht am Schreibtisch. Der Unterschied liegt darin,
            wie weit wir mitgehen.
          </p>
        </div>

        <div class="offers">
          {
            angebote.map((a) => (
              <article class={a.featured ? 'offer is-featured' : 'offer'}>
                <span class="offer-tag">{a.tag}</span>
                <h3>{a.name}</h3>
                <p class="offer-lead">{a.lead}</p>
                <ul class="offer-points">
                  {a.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <div class="offer-price">
                  <strong>{a.price}</strong>
                  <span>{a.priceNote}</span>
                </div>
                <a class={a.featured ? 'btn btn-leaf' : 'btn btn-ghost'} href="#kontakt">
                  {a.cta}
                </a>
              </article>
            ))
          }
        </div>

        <div class="garantie" data-reveal>
          <div class="garantie-siegel" aria-hidden="true">
            <strong>&lt;1</strong>
            <span>Jahr</span>
          </div>
          <div>
            <p class="eyebrow">Kundenversprechen</p>
            <h3>Einsparpotenzialgarantie für den Quickcheck</h3>
            <p>
              Finden wir nicht genügend nicht- oder geringinvestive Maßnahmen mit einer
              Amortisation unter einem Jahr, verzichten wir auf die Rechnungsstellung.
            </p>
            <p class="garantie-bedingung">
              Gültig ab 200.000 € Energiekosten pro Jahr. Die Zusage bezieht sich auf die im
              Quickcheck ermittelten Maßnahmen. Was davon tatsächlich eingespart wird, hängt
              von Umsetzung, Betriebszeiten und Energiepreisen ab.
            </p>
          </div>
        </div>

        <div class="branchen" data-reveal>
          <p class="branchen-intro">
            <strong>Branchenmodule.</strong> Gleiche Norm, andere Sprache: Ein Lackierer hat andere
            Fragen als ein Bürogebäude. Für diese Bereiche liegen fertige Module vor — andere
            Branchen richten wir im Erstgespräch ein.
          </p>
          <ul>
            {
              branchen.map((b) => (
                <li>
                  <strong>{b.name}</strong>
                  <span>{b.copy}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- Multi-Site: Kostenargument für Unternehmen mit mehreren Standorten -->
      <section class="section shell" id="standorte">
        <div class="multisite">
          <div class="multisite-copy" data-reveal>
            <p class="eyebrow">Mehrere Standorte</p>
            <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Zwölf Werke.</span></span><span class="zeile"><span class="zeile-inner"><em>Sechs Audits.</em></span></span></h2>
            <p class="lead" style="margin-top:var(--s3);max-width:44ch">
              Wer mehrere Standorte betreibt, muss nicht jeden einzeln auditieren lassen. Das
              Multi-Site-Verfahren fasst Vergleichbares zusammen und untersucht eine
              repräsentative Stichprobe.
            </p>
            <p class="multisite-source">
              Systematik nach dem Anwendungsbeispiel des Bundesamts für Wirtschaft und
              Ausfuhrkontrolle. Das Verfahren passt zu Filial- und Niederlassungsstrukturen.
              Bei Produktionsstätten und Krankenhäusern ist es meist nicht anwendbar, weil die
              Vergleichbarkeit fehlt — das prüfen wir vorab. Und: Der Gesamtenergieverbrauch
              ist immer vollständig zu erfassen, das Verfahren reduziert nur die Begehungen.
            </p>
          </div>

          <ol class="multisite-steps" data-reveal>
            {
              multiSite.map((m) => (
                <li>
                  <span class="multisite-num" aria-hidden="true">{m.schritt}</span>
                  <div>
                    <strong>{m.titel}</strong>
                    <span>{m.copy}</span>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Ablauf -->
      <section class="method section" id="ablauf">
        <div class="shell method-grid">
          <div class="reveal">
            <p class="eyebrow">03 / Die Zusammenarbeit</p>
            <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Wir beginnen dort, wo Sie</span></span><span class="zeile"><span class="zeile-inner"><em>Energie einsetzen.</em></span></span></h2>
            <p class="lead method-intro">
              Sie kennen Ihren Betrieb. BESS Consulting bringt den systematischen Blick auf Ihren
              Energieeinsatz ein. Ziele, Datenbedarf und Umfang stimmen wir zu Beginn ab.
            </p>
            <p class="prep">
              <strong>Gut für das erste Gespräch</strong>
              Standorte, Energieträger, vorhandene Verbrauchsdaten und Ihr konkretes Anliegen.
              Einen Ansprechpartner im Unternehmen sieht die Norm ohnehin vor.
            </p>
          </div>

          <ol class="steps" data-reveal style="list-style:none;margin:0;padding:0">
            {
              steps.map((s) => (
                <li class="step">
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.copy}</p>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- Ansprechpartner -->
      <section class="section shell expert" id="waldemar">
        <figure class="portrait-panel" data-reveal>
          <img
            class="expert-photo"
            src={url('/assets/waldemar-brauer.jpeg')}
            alt="Waldemar Brauer im Gespräch am Telefon vor einem Industriegebäude"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <div class="role">Ihr Ansprechpartner</div>
            <div class="name">Waldemar Brauer</div>
            <div class="location">BESS Consulting · Weingarten (Baden)</div>
          </figcaption>
        </figure>

        <div class="expert-copy" data-reveal>
          <p class="eyebrow">04 / Ihr Ansprechpartner</p>
          <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Sie sprechen direkt</span></span><span class="zeile"><span class="zeile-inner"><em>mit Waldemar Brauer.</em></span></span></h2>
          <p class="lead">
            Welche Lösung passt zu Ihren Anlagen, Ihren Abläufen und Ihren wirtschaftlichen
            Zielen? Darauf richtet Waldemar Brauer die Beratung aus.
          </p>
          <ul class="expert-points">
            <li>Direkter Austausch über Ihre betrieblichen Fragen</li>
            <li>Technische Analyse mit wirtschaftlicher Einordnung</li>
            <li>Ergebnisse verständlich gemeinsam besprechen</li>
          </ul>
          <div class="qualifikation">
            <img
              class="qualifikation-logo"
              src={url('/assets/eurem-logo.webp')}
              alt="European EnergyManager (EUREM)"
              width="250"
              height="88"
              loading="lazy"
              decoding="async"
            />
            <p>
              <strong>European EnergyManager</strong>
              Standardisierte Weiterbildung für Fachleute der Energieeffizienz, entwickelt unter
              Federführung der IHK Nürnberg für Mittelfranken.
            </p>
          </div>

          <a class="btn btn-ghost" href="mailto:kontakt@bess-consulting.de">Waldemar Brauer eine E-Mail schreiben</a>
        </div>
      </section>

      <!-- FAQ: sechs sichtbar, Rest auf Wunsch -->
      <section class="faq-section section" aria-labelledby="faq-title">
        <div class="shell">
          <div class="section-head" data-reveal data-reveal-stagger>
            <div>
              <p class="eyebrow">05 / Vor dem ersten Gespräch</p>
              <h2 id="faq-title" data-reveal-text><span class="zeile"><span class="zeile-inner">Was Sie vorab</span></span><span class="zeile"><span class="zeile-inner"><em>wissen möchten.</em></span></span></h2>
            </div>
            <p class="lead">
              Die Fragen, die im Erstgespräch am häufigsten kommen. Falls Ihre nicht dabei ist:
              einfach anrufen.
            </p>
          </div>

          <div class="faq-columns">
            {
              faqsPrimary.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p set:html={f.a} />
                </details>
              ))
            }
          </div>

          <div class="faq-columns faq-rest" id="faq-rest" hidden>
            {
              faqsRest.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p set:html={f.a} />
                </details>
              ))
            }
          </div>

          <div class="faq-more">
            <button class="btn btn-ghost" type="button" id="faq-toggle" aria-expanded="false" aria-controls="faq-rest">
              Weitere {faqsRest.length} Fragen anzeigen
            </button>
          </div>
        </div>
      </section>

      <!-- Wissen -->
      <section class="knowledge-teaser shell">
        <div class="teaser-card" data-reveal>
          <div>
            <p class="eyebrow">Wissen für Ihre Entscheidung</p>
            <h2>Manche Fragen brauchen mehr Raum.</h2>
            <p>
              Industriestrompreis, betriebliche Pflichten oder die Vorbereitung des Audits: Im
              Wissensbereich ordnen wir die Hintergründe ein.
            </p>
          </div>
          <div>
            <a class="btn btn-primary" href={url('/blog/')}>Zum Wissen &amp; Blog</a>
          </div>
        </div>
      </section>

      <!-- Kontakt -->
      <section class="contact" id="kontakt">
        <div class="shell">
          <div class="contact-grid">
            <div>
              <p class="eyebrow">Ihr nächster Schritt</p>
              <h2 data-reveal-text><span class="zeile"><span class="zeile-inner">Wo möchten Sie</span></span><span class="zeile"><span class="zeile-inner"><em>genauer hinschauen?</em></span></span></h2>
              <p>
                Nennen Sie uns Ihren Betrieb, Ihren Standort und Ihr Anliegen. Wir besprechen,
                welche Unterstützung Sie brauchen und welche Unterlagen dafür hilfreich sind.
              </p>
              <ul class="contact-expect">
                <li>
                  <span aria-hidden="true">1</span>
                  <span>Ein Gespräch über Ihren Anlass, Ihre Standorte und Ihre Datenlage.</span>
                </li>
                <li>
                  <span aria-hidden="true">2</span>
                  <span>Eine Einschätzung, welcher Leistungsumfang für Sie sinnvoll ist.</span>
                </li>
                <li>
                  <span aria-hidden="true">3</span>
                  <span>Ein Angebot, in dem der Umfang schriftlich festgehalten ist.</span>
                </li>
              </ul>
            </div>

            <div class="contact-card">
              <span class="label">Direkt schreiben</span>
              <a class="mail" href="mailto:kontakt@bess-consulting.de">kontakt@bess-consulting.de</a>
              <span class="phone">
                Oder anrufen: <a href="tel:+4917623724145">+49 176 237 241 45</a>
              </span>
              <address>
                Waldemar Brauer<br />
                Rudolf-Diesel-Straße 14/1<br />
                76356 Weingarten (Baden)
              </address>
            </div>
          </div>

          <div class="booking" id="termin">
            <div class="booking-head">
              <div>
                <p class="eyebrow">Termin direkt wählen</p>
                <h3>Dreißig Minuten, unverbindlich.</h3>
                <p class="booking-lead">
                  Suchen Sie sich einen freien Termin aus. Wir klären Ihren Anlass, den
                  passenden Umfang und welche Unterlagen wir brauchen.
                </p>
              </div>
              <p class="booking-note">
                Die Buchung läuft über Calendly. Der Anbieter fragt eigene Cookie-Einstellungen
                ab und erhält dabei Daten Ihres Browsers.
                <a href={url('/datenschutzerklaerung/')}>Hinweise zum Datenschutz</a>
              </p>
            </div>

            <div class="booking-frame">
              <iframe
                src="https://calendly.com/w-brauer-bess-consulting/30min?primary_color=1d7f95&text_color=12262c&hide_landing_page_details=1"
                title="Terminkalender von Waldemar Brauer, BESS Consulting"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </div>

            <p class="booking-fallback">
              Kalender lädt nicht?
              <a href="https://calendly.com/w-brauer-bess-consulting/30min" target="_blank" rel="noopener noreferrer">
                Termin in neuem Tab wählen
              </a>
            </p>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <div class="footer-top">
          <img class="original-logo" src={url('/assets/bess-logo.webp')} alt="BESS Consulting" width="138" height="54" loading="lazy" />
          <address>
            Waldemar Brauer · Rudolf-Diesel-Straße 14/1<br />
            76356 Weingarten (Baden)
          </address>
        </div>
        <div class="footer-bottom">
          <span>© 2026 BESS Consulting</span>
          <div>
            <a href={url('/impressum/')}>Impressum</a>
            <a href={url('/datenschutzerklaerung/')}>Datenschutz</a>
          </div>
        </div>
        <p class="preview-badge">
          Konzeptentwurf · 10.09.2026 · Inhalte und Rechtstexte vor Veröffentlichung freigeben.
        </p>
      </div>
    </footer>

    <script>
      import '../scripts/ui';
      import '../scripts/motion';
    </script>
  </body>
</html>
