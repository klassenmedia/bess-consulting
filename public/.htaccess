# BESS Consulting — Sicherheits- und Auslieferungs-Header (ALL-INKL / Apache)

<IfModule mod_headers.c>
  # Kein Framing: schützt vor Clickjacking im Namen von BESS
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # Statische Seite ohne Backend: alles aus eigener Herkunft.
  # 'unsafe-inline' bei style-src, weil Astro kritisches CSS inline setzt.
  # data: bei font-src, weil Vite kleine Font-Subsets als data-URI einbettet.
  # Skripte liegen bewusst extern (public/site.js), damit script-src 'self' ohne Hashes trägt.
  # frame-src nur für calendly.com: der Terminkalender wird als iframe eingebettet.
  # Kein script-src für Calendly — das Widget-Skript wird bewusst NICHT geladen.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src https://calendly.com; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"

  # Solange der Entwurf steht: greift auch für Dateien ohne Meta-Tag
  Header always set X-Robots-Tag "noindex, nofollow"

  # HSTS erst nach bestätigtem HTTPS auf der finalen Domain aktivieren:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Bekannter ALL-INKL-Bug: komprimierte Auslieferung ohne Content-Encoding-Header
<IfModule mod_headers.c>
  RequestHeader unset Accept-Encoding
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

Options -Indexes

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

ErrorDocument 404 /404.html
