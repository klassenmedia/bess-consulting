---
import { url } from '../lib/url';
import '@fontsource-variable/manrope';
import '../styles/global.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,follow" />
    <title>Seite nicht gefunden | BESS Consulting</title>
    <meta name="theme-color" content="#0e2a33" />
  </head>
  <body>
    <header class="site-nav">
      <div class="shell nav">
        <a href={url('/')} aria-label="BESS Consulting, zur Startseite">
          <img class="original-logo" src={url('/assets/bess-logo.webp')} alt="BESS Consulting" width="138" height="54" />
        </a>
        <a class="btn btn-primary" href={url('/#kontakt')}>Audit besprechen</a>
      </div>
    </header>

    <main class="shell legal-main">
      <p class="eyebrow">Fehler 404</p>
      <h1>Diese Seite gibt es nicht.</h1>
      <p>
        Der Link ist veraltet oder enthält einen Tippfehler. Von hier kommen Sie zurück in den
        Betrieb:
      </p>
      <ul>
        <li><a href={url('/')}>Startseite mit Leistungsumfang und Ablauf</a></li>
        <li><a href={url('/blog/')}>Wissen &amp; Blog zu Pflichten, Kosten und Strompreis</a></li>
        <li><a href={url('/#kontakt')}>Direkter Kontakt zu Waldemar Brauer</a></li>
      </ul>
    </main>

    <footer class="shell legal-footer">
      <a href={url('/')}>Startseite</a>
      <a href={url('/impressum/')}>Impressum</a>
      <a href={url('/datenschutzerklaerung/')}>Datenschutz</a>
    </footer>
  </body>
</html>
