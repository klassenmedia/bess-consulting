<script is:inline>document.documentElement.classList.add('js');const b=document.querySelector('.menu-button');const n=document.querySelector('.navlinks');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(open));n.classList.toggle('open',open)});n?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{b.setAttribute('aria-expanded','false');n.classList.remove('open')}));document.addEventListener('keydown',e=>{if(e.key==='Escape'&&b?.getAttribute('aria-expanded')==='true'){b.setAttribute('aria-expanded','false');n.classList.remove('open');b.focus()}});</script>
<script>
import { animate, inView } from 'motion';
const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
const desktop = window.matchMedia('(hover: hover) and (min-width: 900px)');
const stage = document.querySelector<HTMLElement>('.audit-stage');
const stack = document.querySelector<HTMLElement>('.audit-stack');
let frame = 0;
const animations: Array<{stop:()=>void}> = [];
if(stage && stack){
 stage.addEventListener('pointermove',event=>{
  if(preference.matches || !desktop.matches)return;
  const bounds=stage.getBoundingClientRect();
  const x=(event.clientX-bounds.left)/bounds.width-.5;
  const y=(event.clientY-bounds.top)/bounds.height-.5;
  cancelAnimationFrame(frame);
  frame=requestAnimationFrame(()=>{stack.style.transform=`rotateX(${-y*6}deg) rotateY(${x*9}deg)`;});
 });
 stage.addEventListener('pointerleave',()=>{cancelAnimationFrame(frame);stack.style.transform='';});
 const reset = ()=>{cancelAnimationFrame(frame);stack.style.transform='';};
 preference.addEventListener('change',()=>{reset();if(preference.matches)animations.forEach(a=>a.stop());});
 desktop.addEventListener('change',reset);
}
inView('.result, .step',element=>{if(!preference.matches)animations.push(animate(element,{y:[16,0]},{duration:.45,ease:'easeOut'}));});
if(!preference.matches)animations.push(animate('.audit-stack',{y:[24,0],opacity:[.7,1]},{duration:.9,ease:'easeOut'}));
</script></body></html>
